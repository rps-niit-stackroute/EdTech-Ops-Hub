# syntax=docker/dockerfile:1.7

FROM node:20-alpine AS builder
WORKDIR /app

# Enable Yarn 1.x via Corepack
RUN corepack enable && corepack prepare yarn@1.22.22 --activate

# Copy dependency manifests first for better layer caching
COPY frontend/package.json frontend/yarn.lock* ./
RUN yarn install --ignore-engines

# Copy the frontend source and build
COPY frontend/ ./
ARG REACT_APP_BACKEND_URL=http://localhost:8001
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
RUN yarn run craco build

FROM nginx:1.27-alpine AS runner
WORKDIR /usr/share/nginx/html

ENV NODE_ENV=production
# Where nginx forwards /api/* — the backend's origin. Matches the docker-compose
# service name for local dev; override with the backend App Service's URL
# (e.g. https://<backend-app>.azurewebsites.net) when deploying to Azure. Keeping
# the browser on a single origin means Azure App Service Authentication's
# redirect-based login flow works for API calls too, not just page loads.
ENV BACKEND_ORIGIN=http://backend:8001

# Remove default config and add a production-ready one
RUN rm -rf /usr/share/nginx/html/* \
    && apk add --no-cache gettext

COPY --from=builder /app/build /usr/share/nginx/html
COPY <<'EOF' /etc/nginx/conf.d/default.conf.template
server {
    listen 3000;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location /api/ {
        proxy_pass ${BACKEND_ORIGIN}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Azure App Service Authentication (Easy Auth) injects these into what this
        # container receives once it's enabled on *this* (frontend) app — forwarded
        # explicitly rather than relying on nginx's default passthrough, since the
        # backend's identity resolution depends on them being present.
        proxy_set_header X-MS-CLIENT-PRINCIPAL-ID $http_x_ms_client_principal_id;
        proxy_set_header X-MS-CLIENT-PRINCIPAL-NAME $http_x_ms_client_principal_name;
        proxy_set_header X-MS-CLIENT-PRINCIPAL $http_x_ms_client_principal;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html references the hashed bundle filenames below, so it must never be
    # cached — otherwise a browser can keep serving a stale index.html (pointing at
    # an old, no-longer-built bundle hash) long after a rebuild, even though the
    # server has moved on. try_files' internal redirect to /index.html re-runs
    # location matching, so this exact-match block also covers client-side routes
    # falling through to it, not just direct hits on "/".
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location /static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
}
EOF

EXPOSE 3000

# Render the template with only BACKEND_ORIGIN substituted — nginx's own $host,
# $remote_addr etc. must NOT be touched by envsubst, so the variable list is explicit.
CMD ["/bin/sh", "-c", "envsubst '$BACKEND_ORIGIN' < /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf && exec nginx -g 'daemon off;'"]
